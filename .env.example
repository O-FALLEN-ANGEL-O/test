# Email: free access key from https://web3forms.com (sent to contact@praxel.space).
VITE_WEB3FORMS_KEY=

# WhatsApp notifications (server-side only — set these in Vercel, never with a VITE_ prefix).
# Register your number at https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Spam protection: reCAPTCHA v3 keys from https://www.google.com/recaptcha/admin (type "Score based (v3)").
# The site key is public; the secret stays on the server.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# Optional, 0..1 (default 0.5). Lower lets more borderline humans through.
RECAPTCHA_MIN_SCORE=
